{
  "rpc_url": "http://127.0.0.1:9091/transmission/rpc",
  "rules": [
    {
      "name": "plus-belle-la-vie",
      "pattern": "(?i)^Plus[.]belle[.]la[.]vie[.]encore[.]plus[.]belle[.]S0[0-9]E[0-9]{2}([ ._-]|$)",
      "destination": "/mnt/sdb/mylen/Plus.belle.la.vie.encore.plus.belle"
    },
    {
      "name": "series",
      "pattern": "(?i)(^|[ ._-])(s[0-9]{1,2}(e[0-9]{1,3})?|[0-9]{1,2}x[0-9]{1,3})([ ._-]|$)",
      "destination": "/mnt/sda/series"
    },
    {
      "name": "movies",
      "pattern": "(^|[ ._(])(19|20)[0-9]{2}([ ._)]|$)",
      "destination": "/mnt/sdb/movies-hd"
    }
  ]
}
